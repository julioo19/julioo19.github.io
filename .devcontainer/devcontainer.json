{
  "name": "Perfil de Visitas - Lab 02",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },

  "forwardPorts": [8080],

  "portsAttributes": {
    "8080": {
      "label": "Web",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cp .env.example .env",

  "postStartCommand": "docker compose up -d"
}